{
  "name": "squircle-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "test": "pnpm -r --filter ./packages/* test",
    "dev": "pnpm --filter site dev",
    "site:build": "pnpm build && pnpm --filter site build",
    "bench": "pnpm --filter ./packages/squircle build && pnpm --filter bench bench",
    "bench:browser": "pnpm --filter bench bench:browser"
  }
}
