{
  "name": "@fohz67/squircle",
  "version": "1.0.0",
  "description": "The fastest Figma-accurate squircles for the web. One ResizeObserver, zero re-renders, real borders (even gradients). Zero dependencies.",
  "license": "MIT",
  "author": "fohz67 (https://github.com/fohz67)",
  "homepage": "https://fohz67.github.io/squircle/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fohz67/squircle.git",
    "directory": "packages/squircle"
  },
  "bugs": "https://github.com/fohz67/squircle/issues",
  "keywords": [
    "border",
    "border-radius",
    "clip-path",
    "corner-smoothing",
    "css",
    "figma",
    "ios",
    "ios-corners",
    "react",
    "react-component",
    "rounded-corners",
    "smooth-corners",
    "squircle",
    "squircles",
    "superellipse"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/write-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node --expose-gc bench/path.bench.mjs",
    "prepack": "cp ../../README.md README.md && pnpm build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "figma-squircle": "1.1.0",
    "happy-dom": "^20.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
